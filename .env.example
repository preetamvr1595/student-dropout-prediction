# Environment variables for the Student Dropout Prediction API
# Copy this file to .env and fill in values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Model Configuration
MODEL_PATH=models/model_sem1.joblib
META_PATH=models/model_meta.json
THRESHOLD=0.17

# AWS Lambda (optional)
AWS_REGION=ap-south-1
LAMBDA_FUNCTION_NAME=dropout-predictor
